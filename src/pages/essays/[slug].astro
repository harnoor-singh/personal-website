---
import type { GetStaticPaths } from 'astro'
import Layout from '~/layouts/Layout.astro'
import { EssaysSeriesGroup, EssaysTagsGroup, getSortedEssays } from '~/utils'
import PostPreview from '~/components/PostPreview.astro'
import DividerText from '~/components/DividerText.astro'
import { getCollection, render, type CollectionEntry } from 'astro:content'
import PostAddendum from '~/components/PostAddendum.astro'
import TableOfContents from '~/components/TableOfContents.astro'
import { Image } from 'astro:assets'
import GiscusLoader from '~/components/GiscusLoader.astro'
import siteConfig from '~/site.config'
import Tags from '~/components/Tags.astro'
import PostInfo from '~/components/PostInfo.astro'
import ScrollUpButton from '~/components/ScrollUpButton.astro'
import type { Collation } from '~/types'
import ChevronsRight from '~/icons/chevrons-right.svg'
import { getEssaySequenceContext } from '~/utils'

export const getStaticPaths = (async () => {
  const essays = await getSortedEssays()
  return essays.map((essay) => {
    // Get sequence context for the essay
    const { prev, next } = getEssaySequenceContext(essay, essays)
    return {
      params: { slug: essay.id },
      props: { essay, prev, next },
    }
  })
}) satisfies GetStaticPaths

const { essay, prev, next } = Astro.props
const essayData = essay.data
const { headings, Content: EssayContent } = await render(essay)
const addendum = await getCollection('addendum')
let AddendumContent
let addendumAvatarImage
if (addendum.length > 0) {
  const addendumEntry = addendum[0]
  const { Content } = await render(addendumEntry)
  AddendumContent = Content
  addendumAvatarImage = addendumEntry.data.avatarImage
}

const sortedEssays = await getSortedEssays()

// Get series essays if this essay is part of a series
let series: Collation<'essays'> | undefined
let nextEssayInSeries: CollectionEntry<'essays'> | undefined
if (essayData.series) {
  const seriesGroup = await EssaysSeriesGroup.build(sortedEssays)
  series = seriesGroup.match(essayData.series)
  if (!series) {
    // This should not happen if series data is correct
    throw new Error(`Series "${essayData.series}" not found`)
  }
  const sequenceContext = getEssaySequenceContext(essay, series.entries)
  nextEssayInSeries = sequenceContext.next
}
const showSeries = series && series.entries.length > 1

let tags: Collation<'essays'>[] | undefined
if (essayData.tags && essayData.tags.length > 0) {
  const tagsGroup = await EssaysTagsGroup.build(sortedEssays)
  tags = tagsGroup.matchMany(essayData.tags)
}
---

<Layout
  title={essayData.title}
  description={essayData.description}
  author={essayData.author}
  tags={essayData.tags}
>
  <article class="max-w-full py-7.5" data-pagefind-body>
    {
      essayData.coverImage && (
        <Image
          priority
          layout="constrained"
          src={essayData.coverImage.src}
          alt={essayData.coverImage.alt}
          class="w-full rounded-xl mb-5"
        />
      )
    }
    <div class="md:mx-2">
      <h1 id={essay.id} class="mb-4 text-[1.75rem] text-heading1 font-semibold">
        # {essayData.title}
      </h1>
      <div class="my-2 border-l-2 border-accent/80 pl-4 py-2">
        <PostInfo post={essay} class="mb-1" />
        {
          tags && (
            <div class="mt-4">
              <Tags tags={tags} />
            </div>
          )
        }
      </div>
    </div>
    <!-- <hr class="border-accent/10 border-2 rounded-xl hidden lg:block" /> -->
    <div class="flex flex-col xl:gap-1 2xl:gap-18 xl:flex-row xl:items-start">
      {essayData.toc && headings.length > 0 && <TableOfContents headings={headings} />}
      <div class="mb-5 xl:min-w-full 2xl:min-w-full prose">
        <EssayContent />
      </div>
    </div>
  </article>
  {
    nextEssayInSeries && (
      <a
        href={`/essays/${nextEssayInSeries.id}`}
        class="button justify-center -mt-8 mb-8 !whitespace-normal text-center flex gap-2 sm:gap-3 items-center"
      >
        <span>Next: {nextEssayInSeries.data.title}</span>
        <ChevronsRight class="size-5 hidden sm:block" />
      </a>
    )
  }
  {
    AddendumContent && (
      <PostAddendum avatarImage={addendumAvatarImage}>
        <AddendumContent />
      </PostAddendum>
    )
  }
  {
    showSeries && series ? (
      <section>
        <DividerText text={`${series.title} Series`} />
        {series.entries.map((seriesEssay) => (
          <PostPreview post={seriesEssay} />
        ))}
      </section>
    ) : prev || next ? (
      <section>
        <DividerText text="More Essays" />
        {prev && <PostPreview post={prev} />}
        {next && <PostPreview post={next} />}
      </section>
    ) : null
  }
  {
    siteConfig.giscus && (
      <section>
        <DividerText text="Comments" />
        <GiscusLoader />
      </section>
    )
  }
  <ScrollUpButton />
</Layout>
