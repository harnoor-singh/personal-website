---
import type { GetStaticPaths } from 'astro'
import Layout from '~/layouts/Layout.astro'
import { TagsGroup, EssaysTagsGroup } from '~/utils'
import Pagination from '~/components/Pagination.astro'
import siteConfig from '~/site.config'
import PostPreview from '~/components/PostPreview.astro'
import PageHeader from '~/components/PageHeader.astro'

// Note: Pagination like '/', '/2', '/3' only works with spread param like [...page]
export const getStaticPaths = (async ({ paginate }) => {
  const postsTagsGroup = await TagsGroup.build()
  const essaysTagsGroup = await EssaysTagsGroup.build()
  
  // Combine both tag groups
  const allTags = [
    ...postsTagsGroup.collations.map((tag) => ({
      slug: tag.titleSlug,
      title: tag.title,
      entries: tag.entries,
    })),
    ...essaysTagsGroup.collations.map((tag) => ({
      slug: tag.titleSlug,
      title: tag.title,
      entries: tag.entries,
    })),
  ]
  
  // Group by slug to merge posts and essays with the same tag
  const mergedTags = new Map()
  for (const tag of allTags) {
    if (mergedTags.has(tag.slug)) {
      const existing = mergedTags.get(tag.slug)
      existing.entries = [...existing.entries, ...tag.entries]
    } else {
      mergedTags.set(tag.slug, tag)
    }
  }
  
  const pages = Array.from(mergedTags.values()).flatMap((tag) => {
    // Use flatMap to lift the posts for each tag into a single array
    return paginate(tag.entries.reverse(), {
      props: { tagTitle: tag.title },
      params: { tag: tag.slug },
      pageSize: siteConfig.pageSize,
    })
  })
  return pages
}) satisfies GetStaticPaths

const { page, tagTitle } = Astro.props
const pageTitle =
  `Tag: ${tagTitle}` + (page.currentPage > 1 ? ` - Page ${page.currentPage}` : '')
---

<Layout title={pageTitle} description={`All posts tagged with ${tagTitle}`}>
  <div class="mt-2 sm:mt-0">
    <PageHeader titlePieces={['tags', tagTitle]} />
    {page.data.map((post) => <PostPreview post={post} />)}
    <Pagination
      prevLink={page.url.prev ? encodeURI(page.url.prev) : undefined}
      prevText="Newer Posts"
      nextLink={page.url.next ? encodeURI(page.url.next) : undefined}
      nextText="Older Posts"
    />
  </div>
</Layout>
